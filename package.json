{
  "name": "@fintlp/openclaw-meshtastic",
  "version": "2026.10.23",
  "description": "An AI agent on your Meshtastic mesh — OpenClaw channel plugin over the official protobuf stack (TCP, HTTP, serial), fully local, no MQTT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fintlp/openclaw-meshtastic.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE",
    "assets/icon.png"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync-manifest": "tsx scripts/sync-manifest.ts",
    "prepack": "npm run sync-manifest && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@meshtastic/core": "2.6.7",
    "@meshtastic/transport-http": "0.2.5",
    "@meshtastic/transport-node": "0.0.2",
    "@meshtastic/transport-node-serial": "0.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "openclaw": "2026.10.1",
    "tsdown": "0.22.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.26"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "meshtastic",
      "label": "Meshtastic",
      "selectionLabel": "Meshtastic (HTTP / TCP / Serial)",
      "docsPath": "/channels/meshtastic",
      "docsLabel": "meshtastic",
      "blurb": "LoRa mesh messaging via Meshtastic protobuf (HTTP, TCP, or USB serial).",
      "order": 68,
      "quickstartAllowFrom": true,
      "cliAddOptions": [
        {
          "flags": "--transport <mode>",
          "description": "tcp (port 4403, recommended), http (4433), or serial"
        },
        {
          "flags": "--host <host>",
          "description": "Meshtastic node host or IP (optionally host:port)"
        },
        {
          "flags": "--tls",
          "description": "Use HTTPS for the Meshtastic HTTP API"
        },
        {
          "flags": "--serial-path <path>",
          "description": "Serial device path for transport=serial"
        },
        {
          "flags": "--baud-rate <n>",
          "description": "Serial baud rate (default 115200)"
        },
        {
          "flags": "--dm-policy <policy>",
          "description": "pairing (default), allowlist, open, or disabled"
        },
        {
          "flags": "--group-transmit",
          "description": "Opt in to channel/broadcast transmission (off by default — airtime rule)"
        }
      ]
    },
    "install": {
      "npmSpec": "@fintlp/openclaw-meshtastic",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.5.26",
      "clawhubSpec": "@fintlp/openclaw-meshtastic"
    },
    "compat": {
      "pluginApi": ">=2026.5.26"
    },
    "build": {
      "openclawVersion": "2026.5.26"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    },
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "runtimeSetupEntry": "./dist/setup-entry.js"
  },
  "homepage": "https://github.com/fintlp/openclaw-meshtastic#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "meshtastic",
    "lora",
    "mesh",
    "mesh-network",
    "radio",
    "off-grid",
    "chat",
    "channel-plugin"
  ]
}
