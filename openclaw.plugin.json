      "uiHints": {
        "": {
          "label": "Meshtastic",
          "help": "Meshtastic mesh channel via official protobuf transports: HTTP API (4433), native TCP (4403, e.g. go-meshtastic-serial2tcp), or USB serial."
        },
        "transport": {
          "label": "Meshtastic Transport",
          "help": "Connection mode: \"http\" (node HTTP API), \"tcp\" (protobuf stream, port 4403), or \"serial\" (local USB)."
        },
        "host": {
          "label": "Meshtastic Host",
          "help": "Hostname or IP for http/tcp. Optional port suffix (host:4433 or host:4403) is supported."
        },
        "port": {
          "label": "Meshtastic Port",
          "help": "Port for the selected transport (default 4433 for http, 4403 for tcp). Ignored when host includes a port."
        },
        "tls": {
          "label": "Meshtastic TLS",
          "help": "Use HTTPS for transport=http only (default false)."
        },
        "serialPath": {
          "label": "Meshtastic Serial Path",
          "help": "Device path for transport=serial (e.g. /dev/ttyUSB0 or /dev/cu.usbserial-0001)."
        },
        "baudRate": {
          "label": "Meshtastic Baud Rate",
          "help": "Serial baud rate for transport=serial (default 115200)."
        },
        "channels": {
          "label": "Meshtastic Mesh Channels",
          "help": "Mesh channel indices (0-7) to listen for broadcast messages."
        },
        "dmPolicy": {
          "label": "Meshtastic DM Policy",
          "help": "Direct message access control (\"pairing\" recommended). \"open\" requires channels.meshtastic.allowFrom=[\"*\"]."
        },
        "groupPolicy": {
          "label": "Meshtastic Group Policy",
          "help": "Broadcast channel access (default \"disabled\": channel traffic never triggers the agent). \"allowlist\" admits only the channels you list, NOT senders — pair it with groupAllowFrom or a per-group allowFrom and requireMention:true, or anyone on a public channel can trigger a session."
        },
        "groupTransmit": {
          "label": "Meshtastic Group Transmit",
          "help": "Default false: the send path refuses every channel/broadcast message (LoRa airtime rule). Set true to opt in to group transmission. The reserved broadcast address (4294967295 / ^all) is always refused."
        },
        "textChunkLimit": {
          "label": "Meshtastic Text Chunk Limit",
          "help": "Maximum characters per outbound mesh text message (default ~200). Long replies are split into chunks."
        },
        "sendRateLimit": {
          "label": "Meshtastic Send Rate Limit",
          "help": "Flood guard: caps outbound airtime packets per rolling window (default 20 per 10 minutes for DMs, 3 for group channels). Refuses with a retry hint when tripped. Set enabled:false to disable."
        },
        "durability": {
          "label": "Inbound Durability",
          "help": "At-least-once inbound delivery across gateway restarts (default on, no setup). Admitted frames are logged locally before dispatch and replayed after a restart — updates and crashes no longer eat messages; a restart mid-turn can duplicate a reply. Pending bodies are blanked at terminal states. Disable only if you cannot accept a pending-body copy at rest (delete the .sqlite + sidecars when opting out)."
        },
        "logInboundMessageContent": {
          "label": "Log Inbound Message Content",
          "help": "When true, Gateway logs include up to 80 characters of inbound mesh text. Default is false (metadata only: sender, target, message id, length)."
        },
        "dmIdentity": {
          "label": "DM Sender Identity",
          "help": "Who may DM the agent (2026.11.1 identity gate): known-keys (default) requires a PKI-verified DM from every number the keybook anchors; strict requires PKI verification from every DM; off restores 2026.10.35 behaviour (forged senders admitted — not recommended)."
        },
        "commandIdentity": {
          "label": "Command Identity",
          "help": "When mesh messages may run commands: verified (default) only from a PKI-verified DM with key continuity; policy restores 2026.10.35 behaviour (forged senders are command-capable — not recommended)."
        },
        "pkiMismatch": {
          "label": "PKI Mismatch Policy",
          "help": "How a sender whose PKI provenance conflicts with the pinned keybook entry is admitted: drop (default) refuses it, unverified admits the message marked unverified (legacy escape hatch; with dmIdentity known-keys or strict a mismatch is dropped anyway). Mismatching senders are never admitted as pki-verified either way."
        },
        "pkiRepin": {
          "label": "PKI Re-Pin (Key Rotation)",
          "help": "Node ids whose stored key pins are cleared at channel start, so the node's next observed key re-pins (TOFU). Use only after a legitimate rotation (factory reset, replaced radio, re-imported private key) and remove the entry once the node verifies again — while listed, every restart re-opens first-seen."
        },
        "pkiManuallyVerified": {
          "label": "PKI Manually Verified Keys",
          "help": "Node ids whose pinned keys you have confirmed out-of-band, enforced at the identity gate: a listed id and its DMs must be PKI-verified. Entries are a node id or the key-bound form !id=<base64 32-byte public key> (read the key off the Meshtastic app — a fingerprint can be ground). Key-bound entries are the strong form for high-value contacts. These pins are never evicted when the key store fills."
        }
      }
    }
  },
  "name": "Meshtastic"
}
